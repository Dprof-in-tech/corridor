# Network follows credentials (like the Weave dashboard's sandbox / live):
# the app's test-mode switch picks the TESTNET pair or the MAINNET pair below.
# NEXT_PUBLIC_POLLAR_NETWORK only sets which one a fresh browser starts on.
NEXT_PUBLIC_POLLAR_NETWORK=testnet          # testnet | mainnet
# Wire the mainnet side of the switch to live credentials. Unset → the mainnet side shows "Coming soon".
NEXT_PUBLIC_MAINNET_LIVE=false

# Pollar — wallets, login, KYC and the Bolivian BOB ramp (dashboard.pollar.xyz).
# One Pollar app per network; each has its own publishable key.
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=pub_testnet_...
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY_MAINNET=pub_mainnet_...
# OAuth popup landing page. Register this exact URL on BOTH Pollar apps' redirect-URI lists
# (and the origin under Build → Domains).
NEXT_PUBLIC_POLLAR_REDIRECT_URI=http://localhost:3006/auth/callback

# Weave — the Nigerian leg (NGN bank rails, routing, LI.FI/CCTP bridge).
# Server-to-server auth with Weave SECRET keys: sk_test_ → sandbox (testnet), sk_live_ → live (mainnet).
WEAVE_API_BASE=http://localhost:4000/api/v1
WEAVE_SECRET_KEY=sk_test_...
WEAVE_SECRET_KEY_LIVE=sk_live_...

# Handle → Stellar address directory, request links, rate limits. Strongly recommended:
# without Upstash the fallback is process memory, which is per instance on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# HMAC secret for Corridor's own wallet-session cookie (SEP-53 challenge login).
# Falls back to a hash of the Weave key; set a dedicated random value in production.
CORRIDOR_SESSION_SECRET=
