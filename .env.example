# Pollar — wallets, login, KYC and the Bolivian BOB ramp (dashboard.pollar.xyz)
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=pub_testnet_...
NEXT_PUBLIC_POLLAR_NETWORK=testnet          # testnet | mainnet (LI.FI Stellar routing is mainnet-only)

# Weave — the Nigerian leg (NGN bank rails, routing, LI.FI/CCTP bridge).
# Server-to-server auth: a Weave SECRET key (sk_test_ → sandbox, sk_live_ → live).
WEAVE_API_BASE=http://localhost:4000/api/v1
WEAVE_SECRET_KEY=sk_test_...

# Handle → Stellar address directory (optional; falls back to in-memory).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
